# Copy to .env for local `netlify dev`, and set the same in the Netlify
# dashboard (Site configuration -> Environment variables) for production.

# Signs session tokens issued at login. Any long random string; changing it
# invalidates all existing logins.
ASSISTO_AUTH_SECRET=

# Master key for the /admin page, used to create the very first admin user
# (before any admin account exists to log in with). Keep this secret - it
# grants full admin access. Any long random string.
ASSISTO_ADMIN_SECRET=
